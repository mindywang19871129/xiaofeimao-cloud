#!/bin/bash
# ============================================================
#  小肥猫学习 · 一键云服务器部署脚本
# ============================================================
#  用法:
#    1. 先在本地 Mac 上打包:  ./deploy.sh pack
#    2. 上传到云服务器:       scp deploy_package.tar.gz root@IP:/root/
#    3. 在云服务器上执行:     ./deploy.sh install
#
#  支持 Ubuntu 22.04 / Debian 12
# ============================================================

set -e

# ==================== 配置区（按需修改）====================
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
INSTALL_DIR="/opt/xiaofeimao"
VENV_DIR="${INSTALL_DIR}/venv"
PYTHON_VERSION="python3"

# 飞书配置（已在代码中硬编码，这里仅做记录）
FEISHU_APP_ID="cli-your-feishu-app-id"
FEISHU_APP_SECRET="your-feishu-app-secret"
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${BLUE}[INFO]${NC}  $*"; }
log_ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
log_err()   { echo -e "${RED}[ERROR]${NC} $*"; }

# ==================== 命令: pack（本地执行） ====================
do_pack() {
    local SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    local PKG_NAME="xiaofeimao_deploy_$(date +%Y%m%d_%H%M%S).tar.gz"
    local TMP_DIR=$(mktemp -d)

    log_info "开始打包部署文件..."

    # 复制核心 Python 文件
    for f in bot_server.py question_generator.py feishu_push.py daily_task.py auto_compress.py; do
        if [ -f "${SCRIPT_DIR}/${f}" ]; then
            cp "${SCRIPT_DIR}/${f}" "${TMP_DIR}/"
            log_ok "  ${f}"
        else
            log_warn "  ${f} 不存在，跳过"
        fi
    done

    # 复制数据/配置文件
    for f in daily_questions.json mistake_book.json system_prompt.md system_prompt_for_feishu_ai.md cloud_prompt_compact.md KET备考计划.md; do
        if [ -f "${SCRIPT_DIR}/${f}" ]; then
            cp "${SCRIPT_DIR}/${f}" "${TMP_DIR}/"
            log_ok "  ${f}"
        fi
    done

    # 复制 HTML 模板
    if [ -f "${SCRIPT_DIR}/今日学习卷_数学+KET.html" ]; then
        cp "${SCRIPT_DIR}/今日学习卷_数学+KET.html" "${TMP_DIR}/"
        log_ok "  今日学习卷模板.html"
    fi

    # 创建目录结构占位
    mkdir -p "${TMP_DIR}/.logs" "${TMP_DIR}/archive/html" "${TMP_DIR}/archive/misc" "${TMP_DIR}/.workbuddy/memory"

    # 复制 memory 文件
    if [ -d "${SCRIPT_DIR}/.workbuddy/memory" ]; then
        cp -r "${SCRIPT_DIR}/.workbuddy/memory/"* "${TMP_DIR}/.workbuddy/memory/" 2>/dev/null || true
        log_ok "  memory/"
    fi

    # 把自己（这个部署脚本）也放进去
    cp "${SCRIPT_DIR}/$(basename "$0")" "${TMP_DIR}/"

    # 打包
    tar czf "${SCRIPT_DIR}/${PKG_NAME}" -C "${TMP_DIR}" .
    rm -rf "${TMP_DIR}"

    local SIZE=$(du -h "${SCRIPT_DIR}/${PKG_NAME}" | cut -f1)
    log_ok "打包完成! ${PKG_NAME} (${SIZE})"
    log_info "上传命令: scp ${PKG_NAME} root@<你的服务器IP>:/root/"
}

# ==================== 命令: install（云服务器执行） ====================
do_install() {
    local SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

    # 必须用 root 或 sudo 运行
    if [ "$EUID" -ne 0 ]; then
        log_err "请用 root 用户运行: sudo ./$(basename "$0") install"
        exit 1
    fi

    log_info "====== 小肥猫学习 云服务器部署 ======"
    log_info "安装目录: ${INSTALL_DIR}"

    # ---- Step 1: 系统依赖 ----
    log_info "[1/7] 安装系统依赖..."
    apt update -qq
    apt install -y -qq python3 python3-pip python3-venv curl wget unzip
    log_ok "系统依赖安装完成"

    # ---- Step 2: 创建目录 ----
    log_info "[2/7] 创建项目目录..."
    mkdir -p "${INSTALL_DIR}" \
             "${INSTALL_DIR}/.logs" \
             "${INSTALL_DIR}/archive/html" \
             "${INSTALL_DIR}/archive/misc" \
             "${INSTALL_DIR}/.workbuddy/memory"

    # 移动文件到安装目录（如果是通过 tar 包上传的）
    if [ -f "${SCRIPT_DIR}/bot_server.py" ]; then
        log_info "复制文件..."
        for f in *.py *.json *.md *.html; do
            [ -f "${SCRIPT_DIR}/${f}" ] && cp "${SCRIPT_DIR}/${f}" "${INSTALL_DIR}/" 2>/dev/null || true
        done
        [ -d "${SCRIPT_DIR}/.workbuddy" ] && cp -r "${SCRIPT_DIR}/.workbuddy"* "${INSTALL_DIR}/" 2>/dev/null || true
    fi
    log_ok "文件就位"

    # ---- Step 3: Python 虚拟环境 ----
    log_info "[3/7] 配置 Python 虚拟环境..."
    if [ ! -d "${VENV_DIR}" ]; then
        ${PYTHON_VERSION} -m venv "${VENV_DIR}"
    fi
    # 安装依赖
    "${VENV_DIR}/bin/pip" install -q --upgrade pip
    "${VENV_DIR}/bin/pip" install -q lark-oapi openai requests
    log_ok "Python 环境就绪 (pip packages installed)"

    # ---- Step 4: 启动脚本 ----
    log_info "[4/7] 配置启动脚本..."
    cat > "${INSTALL_DIR}/run_tasks.sh" << 'TASKSEOF'
#!/bin/bash
# 小肥猫学习 定时任务入口
export DEEPSEEK_API_KEY="__API_KEY_PLACEHOLDER__"
cd "__INSTALL_DIR_PLACEHOLDER__"
source venv/bin/activate

case "$1" in
  daily)    python3 daily_task.py ;;
  compress) python3 auto_compress.py ;;
  *)        echo "用法: $0 {daily|compress}" ;;
esac
TASKSEOF

    # 替换占位符
    sed -i "s|__API_KEY_PLACEHOLDER__|${DEEPSEEK_API_KEY}|g" "${INSTALL_DIR}/run_tasks.sh"
    sed -i "s|__INSTALL_DIR_PLACEHOLDER__|${INSTALL_DIR}|g" "${INSTALL_DIR}/run_tasks.sh"
    chmod +x "${INSTALL_DIR}/run_tasks.sh"
    log_ok "启动脚本就绪"

    # ---- Step 5: systemd 服务 ----
    log_info "[5/7] 配置 systemd 开机自启服务..."
    cat > /etc/systemd/system/xiaofeimao-bot.service << EOF
[Unit]
Description=小肥猫学习 - 飞书机器人服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${INSTALL_DIR}
Environment=DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
ExecStart=${VENV_DIR}/bin/python3 ${INSTALL_DIR}/bot_server.py
Restart=always
RestartSec=5
StandardOutput=append:${INSTALL_DIR}/.logs/bot_server.log
StandardError=append:${INSTALL_DIR}/.logs/bot_server_err.log

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xiaofeimao-bot
    log_ok "systemd 服务已注册 (开机自启已开启)"

    # ---- Step 6: Crontab 定时任务 ----
    log_info "[6/7] 配置定时任务..."

    # 写入 crontab（不覆盖已有的其他定时任务）
    (crontab -l 2>/dev/null | grep -v 'xiaofeimao'; cat << CRONEOF
# 小肥猫学习 - 每日18:00出题推送
0 18 * * * ${INSTALL_DIR}/run_tasks.sh daily >> ${INSTALL_DIR}/.logs/daily_task_cron.log 2>&1

# 小肥猫学习 - 每周日12:00压缩清理
0 12 * * 0 ${INSTALL_DIR}/run_tasks.sh compress >> ${INSTALL_DIR}/.logs/compress_cron.log 2>&1
CRONEOF
) | crontab -

    log_ok "定时任务已配置:"
    echo "         每天 18:00 → 出题推送"
    echo "         每周日 12:00 → 自动压缩"

    # ---- Step 7: 启动并验证 ----
    log_info "[7/7] 启动飞书机器人服务..."
    systemctl start xiaofeimao-bot
    sleep 2

    if systemctl is-active --quiet xiaofeimao-bot; then
        log_ok "✅ bot_server 已启动!"
    else
        log_err "❌ bot_server 启动失败，请检查日志:"
        echo "    journalctl -u xiaofeimao-bot -n 30"
        echo "    tail -20 ${INSTALL_DIR}/.logs/bot_server_err.log"
    fi

    # ---- 最终状态报告 ----
    echo ""
    echo "=========================================================="
    echo -e "${GREEN}  🎉 小肥猫学习 云端部署完成!${NC}"
    echo "=========================================================="
    echo ""
    echo "  安装目录:    ${INSTALL_DIR}"
    echo "  虚拟环境:    ${VENV_DIR}"
    echo ""
    echo "  常用管理命令:"
    echo "    查看状态:  systemctl status xiaofeimao-bot"
    echo "    重启服务:  systemctl restart xiaofeimao-bot"
    echo "    查看日志:  tail -f ${INSTALL_DIR}/.logs/bot_server.log"
    echo "    手动出题:  ${INSTALL_DIR}/run_tasks.sh daily"
    echo "    手动压缩:  ${INSTALL_DIR}/run_tasks.sh compress"
    echo "    查看定时:  crontab -l | grep xiaofeimao"
    echo ""
    echo "  下一步:"
    echo "    1. 打开飞书，给机器人发一条消息测试是否正常"
    echo "    2. 等 18:00 看是否自动推送当日题目"
    echo "    3. 如果有问题: journalctl -u xiaofeimao-bot -f"
    echo ""
}

# ==================== 命令: status（查看状态） ====================
do_status() {
    echo "====== 小肥猫学习 服务状态 ======"
    echo ""

    if command -v systemctl &> /dev/null; then
        echo "--- systemd 服务 ---"
        systemctl status xiaofeimao-bot --no-pager 2>/dev/null || echo "  未找到 systemd 服务(可能未install)"
        echo ""
    fi

    echo "--- Crontab 定时任务 ---"
    crontab -l 2>/dev/null | grep -i "xiaofeimao\|daily_task\|auto_compress" || echo "  无定时任务"
    echo ""

    echo "--- 进程 ---"
    ps aux | grep -E "bot_server|daily_task" | grep -v grep || echo "  无运行中的进程"
    echo ""

    if [ -d "${INSTALL_DIR}" ]; then
        echo "--- 磁盘占用 ---"
        du -sh "${INSTALL_DIR}" 2>/dev/null || echo "  安装目录不存在"
        echo ""
        echo "--- 最近日志 ---"
        [ -f "${INSTALL_DIR}/.logs/bot_server.log" ] && tail -5 "${INSTALL_DIR}/.logs/bot_server.log" || echo "  暂无日志"
    else
        echo "  安装目录 ${INSTALL_DIR} 不存在"
    fi
}

# ==================== 命令: help ====================
do_help() {
    echo "小肥猫学习 - 云部署工具"
    echo ""
    echo "用法:"
    echo "  $0 pack          在本地 Mac 上打包所有部署文件"
    echo "  $0 install       在云服务器上一键安装部署"
    echo "  $0 status        查看服务运行状态"
    echo "  $0 help          显示帮助信息"
    echo ""
    echo "完整流程:"
    echo "  1. 本地执行:  ./$(basename "$0") pack"
    echo "  2. 上传:      scp xiaofeimao_deploy_*.tar.gz root@<IP>:/root/"
    echo "  3. SSH登录后: tar xzf xiaofeimao_deploy_*.tar.gz && ./$(basename "$0") install"
}

# ==================== 入口 ====================
case "${1:-help}" in
    pack)    do_pack ;;
    install) do_install ;;
    status)  do_status ;;
    help|--help|-h) do_help ;;
    *)
        log_err "未知命令: $1"
        do_help
        exit 1
        ;;
esac
