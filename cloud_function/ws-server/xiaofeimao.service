[Unit]
Description=小肥猫学习 WebSocket 长连接批改服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xiaofeimao
WorkingDirectory=/opt/xiaofeimao/cloud_function/ws-server
EnvironmentFile=/opt/xiaofeimao/cloud_function/ws-server/.env
ExecStart=/opt/xiaofeimao/cloud_function/ws-server/venv/bin/python3 /opt/xiaofeimao/cloud_function/ws-server/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/xiaofeimao

[Install]
WantedBy=multi-user.target
