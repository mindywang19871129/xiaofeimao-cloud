# ===================================
# 小肥猫 WebSocket 服务 - 环境变量
# ===================================
# 复制此文件为 .env，填入真实值
# 部署到云服务器时通过 export 或 systemd EnvironmentFile 加载

# --- 飞书应用凭证（必填）---
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- DeepSeek API（必填）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 飞书多维表格 ---
BITABLE_APP_TOKEN=xxxxxxxxxxxx
BITABLE_DAILY_TABLE_ID=tblxxxxxxxxxxxx
BITABLE_MISTAKE_TABLE_ID=tblxxxxxxxxxxxx

# --- 用户 open_id（可选，有默认值）---
USER_OPEN_ID=ou_8bf3770ed43ce0f273c7a34f1597cfe9
